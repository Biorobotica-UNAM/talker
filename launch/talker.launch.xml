<launch>

    <group>
        
        <push_ros_namespace namespace="talker"/>

        <node
            pkg="talker"
            exec="talker_node"
            name="talker_node"
            output="screen">
            <!-- VOZ MIMIC3 -->
            <param name="tts_voice" value="en_US/ljspeech_low"/>
            <!-- MÁS RÁPIDA Y ENERGÉTICA -->
            <param name="tts_speed" value="0.90"/>
            <param name="tts_noise_w" value="0.80"/>
            <param name="tts_noise_scale" value="0.60"/>
            <!-- REPRODUCIR DIRECTO -->
            <param name="tts_output" value="play"/>

        </node>

    </group>

</launch>
