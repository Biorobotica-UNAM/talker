<launch>

    <group>
        
        <push_ros_namespace namespace="talker"/>

        <node
            pkg="talker"
            exec="talker_node"
            name="talker_node"
            output="screen">

     
            <!-- VELOCIDAD -->
            <param name="speed" value="1.0"/>
            <!-- ESCALA DE RUIDO PARA VARIAR LA VOZ (0.0-1.0) -->
            <param name="noise_scale" value="0.667"/>
            <!-- VOLUMEN (0.0-2.0) -->
            <param name="volume" value="1.0"/>
        </node>

    </group>

</launch>
