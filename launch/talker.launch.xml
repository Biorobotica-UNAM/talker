<launch>

    <!-- NAMESPACE-->
    <arg name="namespace" default="talker"/>

    <group>
        
        <push_ros_namespace namespace="$(var namespace)"/>

        <node
            pkg="talker"
            exec="talker"
            name="talker_node"
            output="screen">

            <!-- VOZ -->
            <param name="tts_voice" value="slt"/>
            <!-- VELOCIDAD -->
            <param name="tts_speed" value="1.05"/>
            <!-- VOLUMEN NORMAL, SE PUEDE SUBIR 1.3-1.5 -->
            <param name="tts_volume" value="1.0"/>
            <!-- PITCH -->
            <param name="tts_f0_mean" value="160"/>
            <!-- VARIACION DEL TONO -->
            <param name="tts_f0_std" value="35"/>
            <!-- HABLAR DIRECTO CON FLITE -->
            <param name="tts_output" value="play"/>

        </node>

    </group>

</launch>
