<?xml version="1.0"?>
<package format="3">
  <name>talker</name>
  <version>0.1.0</version>
  <description>ROS 2 node for text-to-speech using espeak-ng</description>

  <maintainer email="marco.soriano5102@comunidad.unam.mx">Marco Soriano</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>talker_interfaces</exec_depend>

  <!-- Dependencies needed to generate .srv interfaces -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Mark this package as containing interface definitions -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
